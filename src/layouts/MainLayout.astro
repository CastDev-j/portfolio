---
import "@/styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      property="og:title"
      content="Andrés Castillo | Desarrollador Frontend & React"
    />
    <meta
      property="og:description"
      content="Portafolio de Andrés Castillo, desarrollador especializado en React, Next.js, Three.js y TypeScript. +15 certificaciones profesionales en tecnologías modernas."
    />
    <meta
      property="og:image"
      content="https://my-portfolio.castdevj.lat/images/og-image.png"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Portafolio de Andrés Castillo - Desarrollador Frontend"
    />
    <meta property="og:url" content="https://my-portfolio.castdevj.lat" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Andrés Castillo Portfolio" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Andrés Castillo | Desarrollador Frontend & React"
    />
    <meta
      name="twitter:description"
      content="Portafolio de Andrés Castillo, desarrollador especializado en React, Next.js, Three.js y TypeScript. +15 certificaciones profesionales."
    />
    <meta
      name="twitter:image"
      content="https://my-portfolio.castdevj.lat/images/og-image.png"
    />
    <meta name="twitter:image:alt" content="Portafolio de Andrés Castillo" />
    <meta name="twitter:creator" content="@CastDev_J" />

    <meta name="author" content="Andrés Castillo Jiménez" />
    <meta
      name="keywords"
      content="React, Next.js, TypeScript, Three.js, Frontend, Portafolio, Desarrollador Web"
    />
    <link rel="canonical" href="https://my-portfolio.castdevj.lat" />
    <Font cssVariable="--font-main" preload />
    <ClientRouter />
    <title>Portfolio</title>
  </head>
  <body>
    <slot />
  </body>
</html>
