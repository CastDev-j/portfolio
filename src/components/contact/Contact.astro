---
import type { Locale } from "@/types";
import { FaEnvelope, FaPhone, FaMapMarkerAlt, FaDownload, FaGithub, FaLinkedin } from "react-icons/fa";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const translations = {
  es: {
    title: "Contacto",
    subtitle: "Estoy abierto a nuevas oportunidades y colaboraciones",
    email: "andres2004_cj@outlook.com",
    phone: "+52 413 128 74 10",
    location: "Celaya, Guanajuato, México",
    cta: "Envíame un correo",
    download: "Descargar CV",
  },
  en: {
    title: "Contact",
    subtitle: "I'm open to new opportunities and collaborations",
    email: "andres2004_cj@outlook.com",
    phone: "+52 413 128 74 10",
    location: "Celaya, Guanajuato, México",
    cta: "Send me an email",
    download: "Download CV",
  },
};

const contactInfo = [
  {
    icon: "email",
    label: "Email",
    value: translations[locale].email,
    href: `mailto:${translations[locale].email}`,
  },
  {
    icon: "phone",
    label: "Teléfono / Phone",
    value: translations[locale].phone,
    href: `tel:${translations[locale].phone.replace(/\s/g, "")}`,
  },
  {
    icon: "location",
    label: "Ubicación / Location",
    value: translations[locale].location,
    href: null,
  },
];

const socialLinks = [
  {
    name: locale === "es" ? "Descargar CV" : "Download CV",
    href: "/doc/cv",
    download: true,
  },
  {
    name: "GitHub",
    href: "https://github.com/CastDev-j",
  },
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/andres-castillo-jimenez-249210292/",
  },
];
---

<main class="flex p-4 w-full items-center justify-center min-h-dvh bg-sea-nymph-50/50" id="contact">
  <section class="flex flex-col w-full max-w-5xl gap-8 sm:gap-12 py-24">
    <article class="text-center">
      <h1 class="text-4xl font-semibold text-sea-nymph-800 mb-2">
        {translations[locale].title}
      </h1>
      <p class="text-sea-nymph-500 text-sm">
        {translations[locale].subtitle}
      </p>
    </article>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto w-full">
      <div class="flex flex-col gap-4">
        <h2 class="text-lg font-semibold text-sea-nymph-700 mb-1">
          {locale === "es" ? "Información de contacto" : "Contact information"}
        </h2>

        {contactInfo.map((info) => (
          <a
            href={info.href ?? undefined}
            {...(info.href ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            class="flex items-center gap-4 p-4 rounded-2xl bg-white/70 backdrop-blur-sm border border-sea-nymph-200 hover:border-sea-nymph-400 hover:shadow-lg transition-all duration-300 group"
          >
            <div class="w-10 h-10 rounded-full bg-sea-nymph-100 flex items-center justify-center shrink-0 group-hover:bg-sea-nymph-500 group-hover:text-white transition-all duration-300 text-sea-nymph-600 group-hover:text-white">
              {
                info.icon === "email" ? <FaEnvelope /> : info.icon === "phone" ? <FaPhone /> : <FaMapMarkerAlt />
              }
            </div>
            <div class="flex flex-col">
              <span class="text-xs text-sea-nymph-400">{info.label}</span>
              <span class="text-sm text-sea-nymph-700 group-hover:text-sea-nymph-600 transition-colors">{info.value}</span>
            </div>
          </a>
        ))}
      </div>

      <div class="flex flex-col gap-4">
        <h2 class="text-lg font-semibold text-sea-nymph-700 mb-1">
          {locale === "es" ? "Redes y enlaces" : "Socials & links"}
        </h2>

        {socialLinks.map((link) => (
          <a
            href={link.href}
            {...(link.download ? { download: true } : { target: "_blank", rel: "noopener noreferrer" })}
            class="flex items-center gap-4 p-4 rounded-2xl bg-white/70 backdrop-blur-sm border border-sea-nymph-200 hover:border-sea-nymph-400 hover:shadow-lg transition-all duration-300 group"
          >
            <div class="w-10 h-10 rounded-full bg-sea-nymph-100 flex items-center justify-center shrink-0 group-hover:bg-sea-nymph-500 group-hover:text-white transition-all duration-300 text-sea-nymph-600 group-hover:text-white">
              {
                link.download ? <FaDownload /> : link.name === "GitHub" ? <FaGithub /> : <FaLinkedin />
              }
            </div>
            <span class="text-sm text-sea-nymph-700 group-hover:text-sea-nymph-600 transition-colors font-medium">
              {link.name}
            </span>
          </a>
        ))}
      </div>
    </div>

    <div class="text-center">
      <a
        href={`mailto:${translations[locale].email}`}
        class="inline-flex items-center gap-2 bg-sea-nymph-500 text-white px-6 py-3 rounded-lg hover:bg-sea-nymph-600 transition-colors text-sm font-medium"
      >
        {translations[locale].cta}
      </a>
    </div>
  </section>
</main>
