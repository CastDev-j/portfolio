{
  "compatibility_date": "2026-05-16",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "name": "my-portfolio",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60,
      },
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "my-portfolio-session-v1",
    },
  ],
}
